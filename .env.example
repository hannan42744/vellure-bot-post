# Copy to .env for local tests only. Never commit real values.
PORT=10000
TZ=Asia/Dhaka
SITE_URL=https://vellurefragrances.com
WHATSAPP_NUMBER=
WEBHOOK_SECRET=any-long-random-string
PUBLIC_URL=            # local test: your https tunnel URL. On Render it is set automatically.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_VIDEO_MODEL=   # see https://openrouter.ai/api/v1/videos/models (check pricing_skus first)
VIDEO_DURATION=5
VIDEO_RESOLUTION=720p
VIDEO_AUDIO=false
OPENROUTER_IMAGE_MODALITIES=image,text   # use "image" for image-only models
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
GRAPH_VERSION=v25.0
PRODUCTS=Armani Style,Desire,Aqua Di Gio,Vampire Blood
# CRON_PRODUCT=0 16 * * *
# CRON_REEL=0 18 * * *
# CRON_BENEFITS=0 19 * * *

# Real product photos from Google Drive (folder shared as "Anyone with the link: Viewer")
GOOGLE_API_KEY=         # Google Cloud Console -> enable Drive API -> create API key (restrict to Drive API)
DRIVE_FOLDER_ID=        # the part after /folders/ in the Drive link
DRIVE_EXCLUDE=cover|logo|banner
IMAGE_MODE=edit         # edit = AI scene around your photo, real = post your photo as is
